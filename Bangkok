<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>방콕 여행 8/12–8/19</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap');

:root{
  --ink: #161B2E;
  --ink-2: #1F2740;
  --cream: #F5EFE3;
  --gold: #D4A574;
  --gold-dim: #8A7355;
  --coral: #FF8B6B;
  --mint: #6FCF97;
  --line: rgba(245,239,227,0.14);
}

*{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html,body{ margin:0; padding:0; }
body{
background: var(--ink);
color: var(--cream);
font-family:'Noto Sans KR', sans-serif;
min-height:100vh;
overflow-x:hidden;
}

.app{
max-width:480px;
margin:0 auto;
min-height:100vh;
display:flex;
flex-direction:column;
position:relative;
}

/* ===== Header ===== */
header{
padding:22px 20px 14px;
position:relative;
z-index:5;
}
.eyebrow{
font-family:'Space Grotesk', sans-serif;
font-size:11px;
letter-spacing:0.18em;
color: var(--gold);
text-transform:uppercase;
margin-bottom:6px;
}
h1{
font-family:'Space Grotesk', sans-serif;
font-size:26px;
font-weight:700;
margin:0;
line-height:1.15;
letter-spacing:-0.01em;
}
h1 span{ color:var(--gold); }

/* ===== Day tabs (boarding stub strip) ===== */
.daystrip{
display:flex;
gap:8px;
overflow-x:auto;
padding:14px 20px 18px;
scrollbar-width:none;
}
.daystrip::-webkit-scrollbar{ display:none; }
.daytab{
flex:0 0 auto;
min-width:56px;
padding:9px 6px 8px;
border-radius:12px;
border:1px solid var(--line);
background: var(--ink-2);
text-align:center;
cursor:pointer;
transition: all .2s ease;
}
.daytab .dow{
font-size:10px;
color:var(--gold-dim);
font-weight:600;
letter-spacing:.04em;
}
.daytab .dnum{
font-family:'Space Grotesk', sans-serif;
font-size:17px;
font-weight:700;
margin-top:2px;
}
.daytab.active{
background: var(--gold);
border-color: var(--gold);
}
.daytab.active .dow{ color:#5B4326; }
.daytab.active .dnum{ color:var(--ink); }

/* ===== Ticket card ===== */
.stage{
flex:1;
padding:0 20px 100px;
position:relative;
}
.ticket{
display:none;
animation: fadeUp .35s ease;
}
.ticket.show{ display:block; }
@keyframes fadeUp{
from{ opacity:0; transform:translateY(10px); }
to{ opacity:1; transform:translateY(0); }
}

.ticket-head{
background: linear-gradient(135deg, var(--ink-2), #232C4A);
border:1px solid var(--line);
border-radius:18px 18px 0 0;
padding:20px 20px 16px;
position:relative;
}
.ticket-head::after{
content:'';
position:absolute;
left:20px; right:20px; bottom:-1px;
border-bottom:2px dashed rgba(212,165,116,0.35);
}
.area-badge{
display:inline-flex;
align-items:center;
gap:6px;
background: rgba(212,165,116,0.14);
color:var(--gold);
font-size:12px;
font-weight:600;
padding:4px 10px;
border-radius:20px;
margin-bottom:10px;
}
.datebig{
font-family:'Space Grotesk', sans-serif;
font-size:32px;
font-weight:700;
line-height:1;
}
.daytitle{
font-size:14px;
color: rgba(245,239,227,0.65);
margin-top:6px;
}

.ticket-body{
background: var(--ink-2);
border:1px solid var(--line);
border-top:none;
border-radius:0 0 18px 18px;
padding:6px 20px 22px;
}

.segment{
padding:16px 0;
border-bottom:1px solid var(--line);
}
.segment:last-child{ border-bottom:none; }

.seg-label{
display:flex;
align-items:center;
gap:8px;
font-size:11px;
font-weight:700;
letter-spacing:.08em;
text-transform:uppercase;
color:var(--gold-dim);
margin-bottom:8px;
}
.seg-icon{
width:22px; height:22px;
display:flex; align-items:center; justify-content:center;
background: rgba(212,165,116,0.12);
border-radius:7px;
font-size:13px;
}
.seg-text{
font-size:15px;
line-height:1.5;
color: var(--cream);
}
.seg-sub{
font-size:13px;
color: rgba(245,239,227,0.55);
margin-top:4px;
}

.maplink{
display:inline-flex;
align-items:center;
gap:5px;
margin-top:9px;
font-size:12.5px;
font-weight:600;
color: var(--mint);
text-decoration:none;
padding:6px 12px;
background: rgba(111,207,151,0.1);
border-radius:20px;
}
.maplink:active{ transform:scale(0.96); }

.massage-tag{
display:inline-flex;
align-items:center;
gap:6px;
background: rgba(255,139,107,0.14);
color: var(--coral);
font-size:13px;
font-weight:600;
padding:6px 12px;
border-radius:20px;
}

.hotel-card{
display:flex;
align-items:center;
gap:10px;
margin-top:6px;
padding:10px 12px;
background: rgba(245,239,227,0.04);
border-radius:12px;
}
.hotel-card .seg-icon{ flex-shrink:0; }
.hotel-name{ font-size:13.5px; font-weight:600; }

/* ===== Recs section ===== */
.recs-toggle{
margin-top:14px;
width:100%;
background:none;
border:1px solid var(--line);
color: var(--cream);
font-family:'Noto Sans KR',sans-serif;
font-size:13.5px;
font-weight:600;
padding:12px;
border-radius:12px;
display:flex;
align-items:center;
justify-content:center;
gap:6px;
cursor:pointer;
}
.recs-toggle .chev{ transition: transform .25s ease; font-size:11px; }
.recs-toggle.open .chev{ transform:rotate(180deg); }

.recs-panel{
display:none;
margin-top:10px;
}
.recs-panel.open{ display:block; }

.rec-group-title{
font-size:11px;
font-weight:700;
letter-spacing:.08em;
text-transform:uppercase;
color:var(--gold-dim);
margin:14px 0 8px;
}
.rec-group-title:first-child{ margin-top:4px; }

.rec-item{
display:flex;
justify-content:space-between;
align-items:center;
padding:11px 12px;
background: rgba(245,239,227,0.03);
border-radius:12px;
margin-bottom:7px;
text-decoration:none;
color:inherit;
}
.rec-item:active{ background: rgba(245,239,227,0.07); }
.rec-main{ flex:1; min-width:0; }
.rec-name{ font-size:14px; font-weight:600; }
.rec-desc{ font-size:12px; color:rgba(245,239,227,0.55); margin-top:2px; }
.rec-rating{
flex-shrink:0;
font-family:'Space Grotesk', sans-serif;
font-size:13px;
font-weight:700;
color:var(--gold);
background: rgba(212,165,116,0.12);
padding:3px 8px;
border-radius:8px;
margin-left:8px;
}

/* ===== Bottom nav ===== */
.navbar{
position:fixed;
bottom:0; left:0; right:0;
max-width:480px;
margin:0 auto;
display:flex;
background: rgba(22,27,46,0.92);
backdrop-filter: blur(12px);
border-top:1px solid var(--line);
padding:10px 20px calc(10px + env(safe-area-inset-bottom));
z-index:10;
}
.navbtn{
flex:1;
background:none;
border:none;
color: rgba(245,239,227,0.4);
font-family:'Space Grotesk', sans-serif;
font-size:22px;
padding:6px;
cursor:pointer;
display:flex;
flex-direction:column;
align-items:center;
gap:3px;
}
.navbtn span{ font-family:'Noto Sans KR',sans-serif; font-size:10px; font-weight:600;}
.navbtn.active{ color: var(--gold); }
.navbtn:disabled{ opacity:0.25; }

/* ===== Shopping page ===== */
.shop-page{ display:none; padding:4px 0 20px; }
.shop-page.show{ display:block; animation: fadeUp .35s ease; }
.shop-cat{
background: var(--ink-2);
border:1px solid var(--line);
border-radius:16px;
padding:16px 18px;
margin-bottom:12px;
}
.shop-cat-title{
font-size:14px;
font-weight:700;
color:var(--gold);
margin-bottom:10px;
}
.shop-row{ padding:8px 0; border-bottom:1px solid var(--line); }
.shop-row:last-child{ border-bottom:none; }
.shop-item-name{ font-size:14px; font-weight:600; }
.shop-item-place{ font-size:12.5px; color:rgba(245,239,227,0.55); margin-top:2px;}
.shop-item-memo{ font-size:12px; color:var(--gold-dim); margin-top:2px;}

/* ===== Places page ===== */
.places-page{ display:none; padding:4px 0 20px; }
.places-page.show{ display:block; animation: fadeUp .35s ease; }
</style>

</head>
