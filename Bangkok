  {cat:"숙소", items:[
    {name:"Grande Centre Point Sukhumvit 55", url:"https://www.google.com/maps/search/?api=1&query=Grande%20Centre%20Point%20Sukhumvit%2055%2C%20Bangkok"},
    {name:"Holiday Inn Express & Suites Central Pier", url:"https://www.google.com/maps/search/?api=1&query=Holiday%20Inn%20Express%20%26%20Suites%20Bangkok%20Central%20Pier%2C%20Bangkok"},
    {name:"Dusit Thani Bangkok", url:"https://www.google.com/maps/search/?api=1&query=Dusit%20Thani%20Bangkok%2C%20Bangkok"},
  ]},
  {cat:"관광 · 명소", items:[
    {name:"Wat Paknam Phasi Charoen", url:"https://www.google.com/maps/search/?api=1&query=Wat%20Paknam%20Phasi%20Charoen%20Bangkok"},
    {name:"Chatuchak Weekend Market", url:"https://www.google.com/maps/search/?api=1&query=Chatuchak%20Weekend%20Market%20Bangkok"},
    {name:"Song Wat Road", url:"https://www.google.com/maps/search/?api=1&query=Song%20Wat%20Road%20Bangkok"},
    {name:"Yaowarat / Chinatown", url:"https://www.google.com/maps/search/?api=1&query=Yaowarat%20Road%20Bangkok"},
    {name:"Talat Noi", url:"https://www.google.com/maps/search/?api=1&query=Talat%20Noi%20Bangkok"},
    {name:"Lumphini Park", url:"https://www.google.com/maps/search/?api=1&query=Lumphini%20Park%20Bangkok"},
    {name:"Benchakitti Park (해질녘 스카이워크)", url:"https://www.google.com/maps/search/?api=1&query=Benchakitti%20Park%20Bangkok"},
    {name:"Jodd Fairs (랭쌥 및 야시장)", url:"https://www.google.com/maps/search/?api=1&query=Jodd%20Fairs%20Bangkok"}
  ]},
  {cat:"쇼핑", items:[
    {name:"ICONSIAM", url:"https://www.google.com/maps/search/?api=1&query=ICONSIAM%20Bangkok"},
    {name:"Siam Paragon", url:"https://www.google.com/maps/search/?api=1&query=Siam%20Paragon%20Bangkok"},
    {name:"centralwOrld", url:"https://www.google.com/maps/search/?api=1&query=centralwOrld%20Bangkok"},
    {name:"EmSphere", url:"https://www.google.com/maps/search/?api=1&query=EmSphere%20Bangkok"},
  ]},
];

let currentDay = 0;

function todayIndex(){
  const now = new Date();
  const y = now.getFullYear();
  for(let i=0;i<DATA.length;i++){
    const [m,d] = DATA[i].date.split('/').map(Number);
    const target = new Date(y, m-1, d);
    if(now.getFullYear()===target.getFullYear() && now.getMonth()===target.getMonth() && now.getDate()===target.getDate()){
      return i;
    }
  }
  return 0;
}

function renderDayStrip(){
  const strip = document.getElementById('daystrip');
  strip.innerHTML = DATA.map((d,i)=>`
    <div class="daytab ${i===currentDay?'active':''}" onclick="selectDay(${i})">
      <div class="dow">${d.dow}</div>
      <div class="dnum">${d.date.split('/')[1]}</div>
    </div>
  `).join('');
}

function renderTicket(d, idx){
  const segsHtml = d.segs.map(s=>`
    <div class="segment">
      <div class="seg-label"><span class="seg-icon">${s.icon}</span>${s.label}</div>
      <div class="seg-text">${s.text}</div>
      ${s.sub ? `<div class="seg-sub">${s.sub}</div>` : ''}
    </div>
  `).join('');

  let footHtml = '<div class="segment">';
  footHtml += `<div class="seg-label"><span class="seg-icon">🏨</span>오늘의 숙소</div>`;
  footHtml += `<div class="hotel-card"><div class="hotel-name">${d.hotel.name}</div></div>`;
  footHtml += `<a class="maplink" href="${d.hotel.url}" target="_blank">🗺️ 숙소 지도</a>`;
  if(d.massage){
    footHtml += `<div style="margin-top:10px;"><span class="massage-tag">💆 ${d.massage}</span></div>`;
  }
  footHtml += '</div>';

  const r = d.recs;
  const hasRecs = (r.restaurants.length>0 || r.cafes.length>0 || (r.desserts&&r.desserts.length>0) || (r.massages&&r.massages.length>0) || (r.lunch&&r.lunch.length>0));
  let recsHtml = '';
  if(hasRecs){
    let panelContent = '';

    if(r.lunch && r.lunch.length){
      panelContent += `<div class="rec-group-title">🍜 추천 점심</div>`;
      r.lunch.forEach(area=>{
        const fd = FOOD_DATA[area];
        if(!fd || !fd.lunch) return;
        fd.lunch.forEach(item=>{
          panelContent += `<a class="rec-item" href="${item.url}" target="_blank">
            <div class="rec-main"><div class="rec-name">${item.name} <span style="color:var(--gold-dim);font-weight:400;font-size:12px;">${item.price||''}</span></div><div class="rec-desc">${item.desc}</div></div>
            <div class="rec-rating">★${item.rating}</div>
          </a>`;
        });
      });
    }

    const areas = [...new Set([...r.restaurants, ...r.cafes, ...(r.desserts||[]), ...(r.massages||[])])];
    areas.forEach(area=>{
      const fd = FOOD_DATA[area];
      if(!fd) return;
      if(r.restaurants.includes(area) && fd.restaurants && fd.restaurants.length){
        panelContent += `<div class="rec-group-title">🍽️ ${area} · 맛집 (★4.5+)</div>`;
        fd.restaurants.forEach(item=>{
          panelContent += `<a class="rec-item" href="${item.url}" target="_blank">
            <div class="rec-main"><div class="rec-name">${item.name} <span style="color:var(--gold-dim);font-weight:400;font-size:12px;">${item.price||''}</span></div><div class="rec-desc">${item.desc}</div></div>
            <div class="rec-rating">★${item.rating}</div>
          </a>`;
        });
      }
      if(r.cafes.includes(area) && fd.cafes && fd.cafes.length){
        panelContent += `<div class="rec-group-title">☕ ${area} · 카페 (★4.5+)</div>`;
        fd.cafes.forEach(item=>{
          panelContent += `<a class="rec-item" href="${item.url}" target="_blank">
            <div class="rec-main"><div class="rec-name">${item.name}</div><div class="rec-desc">${item.desc}</div></div>
            <div class="rec-rating">★${item.rating}</div>
          </a>`;
        });
      }
      if(r.desserts && r.desserts.includes(area) && fd.desserts && fd.desserts.length){
        panelContent += `<div class="rec-group-title">🍰 ${area} · 디저트</div>`;
        fd.desserts.forEach(item=>{
          panelContent += `<a class="rec-item" href="${item.url}" target="_blank">
            <div class="rec-main"><div class="rec-name">${item.name}</div><div class="rec-desc">${item.desc}</div></div>
            <div class="rec-rating">★${item.rating}</div>
          </a>`;
        });
      }
      if(r.massages && r.massages.includes(area) && fd.massages && fd.massages.length){
        panelContent += `<div class="rec-group-title">💆 ${area} · 마사지 (★4.7+)</div>`;
        fd.massages.forEach(item=>{
          panelContent += `<a class="rec-item" href="${item.url}" target="_blank">
            <div class="rec-main"><div class="rec-name">${item.name}</div><div class="rec-desc">${item.desc}</div></div>
            <div class="rec-rating">★${item.rating}</div>
          </a>`;
        });
      }
    });

    recsHtml = `
      <button class="recs-toggle" id="recsToggle${idx}" onclick="toggleRecs(${idx})">
        <span>📋 오늘 지역 맛집·카페·디저트 후보 보기</span><span class="chev">▾</span>
      </button>
      <div class="recs-panel" id="recsPanel${idx}">${panelContent}</div>
    `;
  }

  return `
    <div class="ticket-head">
      <div class="area-badge">📍 ${d.area}</div>
      <div class="datebig">${d.date} <span style="font-size:16px;font-weight:600;color:rgba(245,239,227,0.5);">(${d.dow})</span></div>
      <div class="daytitle">${d.title}</div>
    </div>
    <div class="ticket-body">
      ${segsHtml}
      ${footHtml}
      ${recsHtml}
    </div>
  `;
}

function renderStage(){
  const stage = document.getElementById('stage');
  stage.innerHTML = DATA.map((d,i)=>`
    <div class="ticket ${i===currentDay?'show':''}" id="ticket${i}">${renderTicket(d,i)}</div>
  `).join('');
}

function selectDay(i){
  currentDay = i;
  renderDayStrip();
  renderStage();
  const strip = document.getElementById('daystrip');
  const activeTab = strip.children[i];
  if(activeTab) activeTab.scrollIntoView({behavior:'smooth', inline:'center', block:'nearest'});
  window.scrollTo({top:0, behavior:'smooth'});
}

function toggleRecs(idx){
  const btn = document.getElementById('recsToggle'+idx);
  const panel = document.getElementById('recsPanel'+idx);
  btn.classList.toggle('open');
  panel.classList.toggle('open');
}

function renderShop(){
  const el = document.getElementById('shopPage');
  el.innerHTML = SHOP_DATA.map(cat=>`
    <div class="shop-cat">
      <div class="shop-cat-title">${cat.cat}</div>
      ${cat.items.map(it=>`
        <div class="shop-row">
          <div class="shop-item-name">${it.name}</div>
          <div class="shop-item-place">${it.place}</div>
          <div class="shop-item-memo">${it.memo}</div>
        </div>
      `).join('')}
    </div>
  `).join('');
}

function renderPlaces(){
  const el = document.getElementById('placesPage');
  el.innerHTML = PLACES_DATA.map(cat=>`
    <div class="shop-cat">
      <div class="shop-cat-title">${cat.cat}</div>
      ${cat.items.map(it=>`
        <a class="rec-item" href="${it.url}" target="_blank" style="margin-bottom:7px;">
          <div class="rec-main"><div class="rec-name">${it.name}</div></div>
          <div style="color:var(--mint); font-size:18px;">↗</div>
        </a>
      `).join('')}
    </div>
  `).join('');
}

function showView(view){
  document.getElementById('daystrip').style.display = view==='days' ? 'flex' : 'none';
  document.getElementById('stage').style.display = view==='days' ? 'block' : 'none';
  document.getElementById('shopPage').classList.toggle('show', view==='shop');
  document.getElementById('placesPage').classList.toggle('show', view==='places');

  document.getElementById('navDays').classList.toggle('active', view==='days');
  document.getElementById('navShop').classList.toggle('active', view==='shop');
  document.getElementById('navPlaces').classList.toggle('active', view==='places');

  window.scrollTo({top:0, behavior:'smooth'});
}

// swipe support
let touchStartX = 0;
document.addEventListener('touchstart', e=>{ touchStartX = e.touches[0].clientX; });
document.addEventListener('touchend', e=>{
  const dx = e.changedTouches[0].clientX - touchStartX;
  if(document.getElementById('stage').style.display === 'none') return;
  if(Math.abs(dx) > 60){
    if(dx < 0 && currentDay < DATA.length-1) selectDay(currentDay+1);
    else if(dx > 0 && currentDay > 0) selectDay(currentDay-1);
  }
});

// init
currentDay = todayIndex();
renderDayStrip();
renderStage();
renderShop();
renderPlaces();
</script>

</body>
</html>
