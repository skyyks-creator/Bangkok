    <h1>방콕 <span>여행 일정</span></h1>
  </header>

  <div class="daystrip" id="daystrip"></div>

  <div class="stage" id="stage">
    <!-- 일정 티켓들이 여기 렌더링 -->
  </div>

  <!-- 쇼핑 페이지 -->
  <div class="stage shop-page" id="shopPage"></div>

  <!-- 장소 페이지 -->
  <div class="stage places-page" id="placesPage"></div>

  <nav class="navbar">
    <button class="navbtn active" id="navDays" onclick="showView('days')">
      <span>📅</span>
      <span>일정</span>
    </button>
    <button class="navbtn" id="navShop" onclick="showView('shop')">
